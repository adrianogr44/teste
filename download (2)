function VerifiedBadge({ verified, text }: { verified: boolean; text?: string }) {
  if (verified) {
    return (
      <span className="brand-badge verified-badge">
        <CheckCircle2 size={10} />
        {text || "Verificado"}
      </span>
    );
  }
  return (
    <span className="brand-badge not-found-badge">
      <AlertCircle size={10} />
      {text || "Estimado/Não encontrado"}
    </span>
  );
}

function IconComponent({ icon }: { icon: string }) {
  const props = { size: 16, className: "flex-shrink-0" };
  switch (icon) {
    case "trend": return <TrendingUp {...props} />;
    case "users": return <Users {...props} />;
    case "shopping": return <ShoppingBag {...props} />;
    case "shield": return <Shield {...props} />;
    case "star": return <Star {...props} />;
    default: return <Star {...props} />;
  }
}

function DataRow({ label, value, note, verified, mono }: {
  label: string;
  value: string;
  note?: string;
  verified?: boolean;
  mono?: boolean;
}) {
  const isNotFound = value === "Não encontrado" || value === "Não possui site de e-commerce" || value === "Não aplicável — venda exclusivamente presencial e via WhatsApp";
  return (
    <div className="py-3 border-b border-border last:border-0">
      <div className="flex items-start justify-between gap-2 mb-1">
        <span className="text-xs font-semibold text-muted-foreground uppercase tracking-wide">{label}</span>
        {verified !== undefined && <VerifiedBadge verified={verified} />}
      </div>
      <p className={`text-sm leading-relaxed ${isNotFound ? "text-muted-foreground italic" : "text-foreground"} ${mono ? "font-mono text-xs" : ""}`}>
        {value}
      </p>
      {note && (
        <p className="text-xs text-muted-foreground mt-1 italic">{note}</p>
      )}
    </div>
  );
}

