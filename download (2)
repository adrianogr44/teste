                className="rounded-xl p-5 border"
                style={{ background: c.colorLight, borderColor: `${c.color}30` }}
              >
                <div className="flex items-center gap-2 mb-3">
                  <div className="w-3 h-3 rounded-full" style={{ background: c.color }} />
                  <span className="font-semibold text-sm" style={{ color: c.color }}>{c.name}</span>
                </div>
                <p className="text-xs text-muted-foreground leading-relaxed">
                  {c.id === "babykids" && "Modelo feirão físico recorrente em BH/MG. Forte presença no Instagram com foco em urgência e WhatsApp. Sem e-commerce digital. Estratégia 100% presencial + WhatsApp."}
                  {c.id === "paulimar" && "Maior presença digital dos três. 161K seguidores verificados. Envia para todo o Brasil. Referência em autoridade de marca (30+ anos). Catálogo WhatsApp ativo. Melhor posicionamento geral."}
                  {c.id === "babyshopping" && "Duas lojas físicas em João Pessoa/PB. Alta frequência de posts. Delivery local bem estruturado. Frete grátis para móveis. Sem e-commerce próprio ativo. Forte no Instagram local."}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── CARDS INDIVIDUAIS ── */}
      <section id="marcas" className="py-12 border-t border-border" style={{ background: "white" }}>
        <div className="container">
          <div className="section-label mb-2">Análise Detalhada</div>
          <h2 className="text-2xl font-bold mb-2" style={{ fontFamily: "var(--font-display)" }}>
            Perfil completo de cada concorrente
          </h2>
          <p className="text-sm text-muted-foreground mb-8">
            Clique nas abas Instagram / Site / Pontos Fortes para navegar pelos dados de cada marca.
          </p>
          <div className="grid lg:grid-cols-3 gap-6">
            {competitors.map((c) => (
              <div key={c.id} id={c.id}>
                <CompetitorCard competitor={c} />
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── GRÁFICOS ── */}
      <section id="graficos" className="py-14 border-t border-border">
        <div className="container">
          <div className="section-label mb-2">Visualizações</div>
          <h2 className="text-2xl font-bold mb-8" style={{ fontFamily: "var(--font-display)" }}>
            Dados em perspectiva
          </h2>

          <div className="grid lg:grid-cols-2 gap-8">
            {/* Seguidores */}
            <div className="bg-white rounded-2xl p-6 shadow-sm border border-border">
              <p className="section-label mb-1">Seguidores no Instagram</p>
              <p className="text-xs text-muted-foreground mb-4">Baby Shopping: dado não encontrado (login exigido)</p>
              <ResponsiveContainer width="100%" height={260}>
                <BarChart data={followersData} margin={{ top: 5, right: 10, left: 10, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="name" tick={{ fontSize: 11 }} />
                  <YAxis tick={{ fontSize: 11 }} tickFormatter={(v) => v >= 1000 ? `${v / 1000}K` : v} />
                  <Tooltip
                    contentStyle={{ fontSize: "11px", borderRadius: "8px" }}
                    formatter={(value: number, _name, props) => [
                      value === 0 ? "Não encontrado" : `${value.toLocaleString("pt-BR")} (${props.payload.nota})`,
                      "Seguidores"
                    ]}
                  />
                  <Bar dataKey="seguidores" radius={[6, 6, 0, 0]}>
                    {followersData.map((entry, index) => (
                      <Cell key={`cell-${index}`} fill={entry.color} />
                    ))}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </div>

            {/* Presença digital */}
            <div className="bg-white rounded-2xl p-6 shadow-sm border border-border">
              <p className="section-label mb-1">Presença Digital por Dimensão</p>
              <p className="text-xs text-muted-foreground mb-4">Escala 0–10 baseada em dados verificados</p>
              <ResponsiveContainer width="100%" height={260}>
                <BarChart data={presenceData} margin={{ top: 5, right: 10, left: 0, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="#f0f0f0" />
                  <XAxis dataKey="categoria" tick={{ fontSize: 10 }} />
                  <YAxis tick={{ fontSize: 11 }} domain={[0, 10]} />
                  <Tooltip contentStyle={{ fontSize: "11px", borderRadius: "8px" }} />
                  <Legend iconType="circle" iconSize={8} wrapperStyle={{ fontSize: "11px" }} />
                  <Bar dataKey="Baby Kids" fill="#5B7FA6" radius={[4, 4, 0, 0]} />
                  <Bar dataKey="Paulimar Baby" fill="#4A7C59" radius={[4, 4, 0, 0]} />
                  <Bar dataKey="Baby Shopping" fill="#C17D3C" radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </div>
        </div>
      </section>

      {/* ── TABELA COMPARATIVA ── */}
      <section id="tabela" className="py-14 border-t border-border" style={{ background: "white" }}>
        <div className="container">
          <div className="section-label mb-2">Tabela Comparativa</div>
          <h2 className="text-2xl font-bold mb-6" style={{ fontFamily: "var(--font-display)" }}>
            Resumo lado a lado
          </h2>
          <div className="overflow-x-auto rounded-xl border border-border">
            <table className="w-full text-sm">
              <thead>
                <tr style={{ background: "var(--brand-cream)" }}>
                  <th className="text-left p-4 font-semibold text-muted-foreground text-xs uppercase tracking-wide border-b border-border">Dimensão</th>
                  {competitors.map((c) => (
                    <th key={c.id} className="text-left p-4 border-b border-border">
                      <div className="flex items-center gap-2">
                        <div className="w-2.5 h-2.5 rounded-full" style={{ background: c.color }} />
                        <span className="font-semibold text-xs" style={{ color: c.color }}>{c.name}</span>
                      </div>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {[
                  {
                    label: "Instagram (seguidores)",
                    values: ["~28.000 (estimado)", "161.000 ✓", "Não encontrado"],
                  },
                  {
                    label: "Site / Plataforma",
                    values: ["Sem site de e-commerce", "WhatsApp Business Catalog", "Sem site ativo (babyshopping.com.br inativo)"],
                  },
                  {
                    label: "Envio",
                    values: ["Somente presencial/BH", "Todo o Brasil ✓", "Grande João Pessoa (delivery)"],
                  },
                  {
                    label: "Formas de Pagamento",
                    values: ["Pix, dinheiro, cartão", "Pix (10% desc.), cartão 6x", "Pix (10% desc.), cartão 6x, dinheiro"],
                  },
                  {
                    label: "Prova Social",
                    values: ["Comentários no Instagram", "Depoimentos + 30 anos de mercado", "Comentários + celebridades locais"],
                  },
                  {
                    label: "Selos de Confiança",
                    values: ["Não encontrado", "Autoridade: 30+ anos de mercado", "Não encontrado em plataforma digital"],
                  },
                  {
                    label: "Pontos Fortes (destaque)",
                    values: ["Urgência/feirão + WhatsApp direto", "Autoridade de marca + envio nacional", "Frequência de posts + delivery local"],
                  },
                ].map((row, i) => (
                  <tr key={i} className={i % 2 === 0 ? "bg-white" : ""} style={i % 2 !== 0 ? { background: "var(--brand-cream)" } : {}}>
                    <td className="p-4 font-medium text-xs text-muted-foreground uppercase tracking-wide border-b border-border">{row.label}</td>
                    {row.values.map((val, j) => (
                      <td key={j} className="p-4 text-sm border-b border-border">
                        {val.includes("Não encontrado") || val.includes("Sem site") || val.includes("inativo") ? (
                          <span className="text-muted-foreground italic">{val}</span>
                        ) : val.includes("✓") ? (
                          <span className="font-medium" style={{ color: competitors[j].color }}>{val}</span>
                        ) : (
                          val
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* ── METODOLOGIA ── */}
      <section className="py-10 border-t border-border">
        <div className="container">
          <div className="max-w-2xl">
            <div className="section-label mb-2">Metodologia e Fontes</div>
            <h2 className="text-xl font-bold mb-4" style={{ fontFamily: "var(--font-display)" }}>
              Como os dados foram coletados
            </h2>
            <div className="space-y-3 text-sm text-muted-foreground">
              <p>
                <strong className="text-foreground">Instagram:</strong> Dados coletados via extração pública de URLs do Instagram (sem login) e busca em posts públicos. O Instagram exige autenticação para visualizar perfis completos no browser; dados de seguidores foram obtidos via extração direta de metadados públicos onde disponível. Quando não verificável, indicado como "estimado" ou "não encontrado".
              </p>
              <p>
                <strong className="text-foreground">Sites:</strong> Acesso direto às URLs identificadas nos perfis do Instagram (link na bio, Linktree, etc.). Plataformas identificadas por análise de código-fonte e comportamento do site.
              </p>
              <p>
                <strong className="text-foreground">Pagamentos e categorias:</strong> Extraídos de legendas de posts do Instagram onde os preços e condições eram explicitamente mencionados.
              </p>
              <p>
                <strong className="text-foreground">Data de coleta:</strong> Junho de 2026.
              </p>
            </div>
            <div className="mt-4 flex flex-wrap gap-3">
              {competitors.map((c) => (
                <a
                  key={c.id}
                  href={c.instagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="inline-flex items-center gap-1.5 text-xs hover:underline"
                  style={{ color: c.color }}
                >
                  <ExternalLink size={11} />
                  {c.handle}
                </a>
              ))}
              <a
                href="https://linktr.ee/paulimarbaby"
                target="_blank"
                rel="noopener noreferrer"
                className="inline-flex items-center gap-1.5 text-xs hover:underline"
                style={{ color: "#4A7C59" }}
              >
                <ExternalLink size={11} />
                linktr.ee/paulimarbaby
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* ── FOOTER ── */}
      <footer className="py-6 border-t border-border" style={{ background: "white" }}>
        <div className="container flex flex-col sm:flex-row items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <div className="w-5 h-5 rounded flex items-center justify-center" style={{ background: "var(--brand-green)" }}>
              <ShoppingBag size={10} color="white" />
            </div>
            <span className="text-xs text-muted-foreground">Análise Competitiva — Moda Infantil & Enxoval · Jun/2026</span>
          </div>
          <p className="text-xs text-muted-foreground">
            Dados coletados de fontes públicas. Todos os direitos das marcas pertencem aos seus respectivos proprietários.
          </p>
        </div>
      </footer>
    </div>
  );
}
